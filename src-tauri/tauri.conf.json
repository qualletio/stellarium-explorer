{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellarium Explorer",
  "version": "0.1.3",
  "identifier": "sh.stellarium.explorer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stellarium Explorer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOTVFNDcxQzM1RjZDQ0YKUldUUGJGL0RjZVNWOGlkTnNYQ2o4OXJWQ3RSejlMa1RqMGg5cndFZ1E1b045d01QQkVhbkFDVnMK",
      "endpoints": [
        "https://github.com/qualletio/stellarium-explorer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
